# This project reads ../.env first, then overrides it with this local .env.
# Never commit real private keys or API credentials.

# Polygon Amoy testnet only (chain ID 80002).
# Optional comma-separated list. The client also has three built-in fallbacks.
AMOY_RPC_URLS=https://polygon-amoy-bor-rpc.publicnode.com,https://rpc-amoy.polygon.technology
CHAIN_ID=80002

# POLYMARKET_PRIVATE_KEY takes precedence over the root ETH_PRIVATE_KEY.
# It must control the Deposit Wallet owner or an approved session signer.
POLYMARKET_PRIVATE_KEY=
DEPOSIT_WALLET=

# Polymarket does not document the production host as an Amoy order endpoint.
# Set this only if Polymarket gives you a dedicated Amoy CLOB host.
CLOB_TESTNET_API_URL=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Required only if Polymarket provides you with a dedicated Amoy relayer.
# Never put https://relayer-v2.polymarket.com here: that is Polygon production.
RELAYER_TESTNET_URL=
# Current recommended relayer authentication. RELAYER_API_KEY_ADDRESS is the
# wallet address that created/owns the key; for personal use it is normally
# the address derived from POLYMARKET_PRIVATE_KEY.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Legacy HMAC Builder credentials remain supported. Leave these empty when
# using RELAYER_API_KEY.
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASS_PHRASE=

# Custom journal contract, filled after npm run deploy.
TRADE_JOURNAL_ADDRESS=

# Order parameters. TOKEN_ID must be selected from a current active market.
TOKEN_ID=
ORDER_SIDE=BUY
ORDER_PRICE=0.01
ORDER_SIZE=1
ORDER_TYPE=GTC
TICK_SIZE=0.01
NEG_RISK=false

# Safety switches. Read-only checks and local signing work without these.
LIVE_ACTION=NONE
# Allowed values for LIVE_ACTION:
# DEPLOY_DEPOSIT_WALLET, DEPLOY_JOURNAL, RECORD_INTENT, PLACE_TEST_ORDER
LIVE_CONFIRMATION=
